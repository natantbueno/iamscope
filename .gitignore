# Dependencies
/node_modules

# Next.js build output
/.next
/out

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# Saídas DERIVADAS do changelog. Os snapshots em data/snapshots/ e o
# data/changelog/attested.json SÃO versionados — eles são o histórico, e sem
# eles não há changelog nenhum. O que está abaixo é reconstruível a partir
# deles a qualquer momento por scripts/build-changelog.js, e versionar derivado
# só produz conflito de merge em arquivo que ninguém lê.
/public/changelog.json
/public/feeds
/public/api

# Debug / scratch files gerados pelos scripts de fetch (não publicar)
scripts/debug-*.html
scripts/*-raw.json

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Env
.env
.env*.local
