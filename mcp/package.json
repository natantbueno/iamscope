{
  "name": "iamscope-mcp",
  "version": "0.1.1",
  "description": "MCP server com o catálogo do IAM Scope: 4.640 roles e 30.865 permissões de seis nuvens (Entra ID, Azure RBAC, AWS IAM, GCP IAM, Google Workspace, IBM Cloud), respondendo na sua máquina, sem rede.",
  "type": "module",
  "bin": {
    "iamscope-mcp": "dist/server.mjs"
  },
  "main": "dist/server.mjs",
  "files": [
    "dist/",
    "data/",
    "README.md",
    "DATA-LICENSE.md"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "node build.mjs",
    "stats": "node scripts/gen-stats.mjs",
    "smoke": "node scripts/smoke.mjs",
    "metrics": "node scripts/metrics.mjs",
    "prepublishOnly": "npm run build && npm run smoke"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "iam",
    "rbac",
    "entra-id",
    "azure-rbac",
    "aws-iam",
    "gcp-iam",
    "google-workspace",
    "ibm-cloud",
    "least-privilege",
    "segregation-of-duties",
    "sod",
    "cloud-security"
  ],
  "author": "IAM Scope (https://iamscope.cloud)",
  "license": "SEE LICENSE IN DATA-LICENSE.md",
  "homepage": "https://iamscope.cloud",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/natantbueno/iamscope.git",
    "directory": "mcp"
  },
  "bugs": {
    "url": "https://github.com/natantbueno/iamscope/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
