{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, HEAD, OPTIONS" },
        { "key": "Access-Control-Max-Age", "value": "86400" },
        { "key": "X-IAMScope-License", "value": "CC-BY-4.0" }
      ]
    },
    {
      "source": "/api/v1/(.*)",
      "headers": [{ "key": "X-IAMScope-Contract", "value": "public-v1" }]
    },
    {
      "source": "/api/v1/index.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=3600" }
      ]
    },
    {
      "source": "/api/v1/roles/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/api/v1/permissions/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/api/v1/meta/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/api/v1/changes.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=1800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/feeds/(.*).xml",
      "headers": [
        { "key": "Content-Type", "value": "application/atom+xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=1800, stale-while-revalidate=86400" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "X-IAMScope-Contract", "value": "public-v1" },
        { "key": "X-IAMScope-License", "value": "CC-BY-4.0" }
      ]
    },

    {
      "source": "/azure-perms/(.*)",
      "headers": [
        { "key": "X-IAMScope-Contract", "value": "internal-unstable" },
        { "key": "Access-Control-Allow-Origin", "value": "https://iamscope.cloud" }
      ]
    },
    {
      "source": "/gcp-perms/(.*)",
      "headers": [
        { "key": "X-IAMScope-Contract", "value": "internal-unstable" },
        { "key": "Access-Control-Allow-Origin", "value": "https://iamscope.cloud" }
      ]
    },
    {
      "source": "/aws-policy-docs/(.*)",
      "headers": [
        { "key": "X-IAMScope-Contract", "value": "internal-unstable" },
        { "key": "Access-Control-Allow-Origin", "value": "https://iamscope.cloud" }
      ]
    },
    {
      "source": "/aws-actions-index.json",
      "headers": [
        { "key": "X-IAMScope-Contract", "value": "internal-unstable" },
        { "key": "Access-Control-Allow-Origin", "value": "https://iamscope.cloud" }
      ]
    },
    {
